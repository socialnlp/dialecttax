"សូមសរសេរអនុគមន៍ python ដើម្បីរកផលបូកនៃផលគុណនៃបញ្ជីរងដែលអាចធ្វើទៅបានទាំងអស់នៃបញ្ជីដែលបានផ្តល់ឱ្យ។ >>> python_function([1,2,3]) 20"
"ម៉ាទ្រីសការ៉េដែលមានទំហំ N*N ត្រូវបានផ្តល់ជាបញ្ជីនៃបញ្ជី ដែលក្រឡានីមួយៗត្រូវបានភ្ជាប់ជាមួយនឹងថ្លៃដើមជាក់លាក់មួយ។ ផ្លូវមួយត្រូវបានកំណត់ថាជាលំដាប់ជាក់លាក់នៃក្រឡាដែលចាប់ផ្តើមពីក្រឡាខាងលើឆ្វេងផ្លាស់ទីតែទៅស្តាំ ឬចុះក្រោម ហើយបញ្ចប់នៅក្រឡាខាងក្រោមស្តាំ។ យើងចង់ស្វែងរកផ្លូវដែលមានមធ្យមភាគអតិបរមាលើផ្លូវដែលមានស្រាប់ទាំងអស់។ មធ្យមភាគត្រូវបានគណនាជាថ្លៃដើមសរុបចែកនឹងចំនួនក្រឡាដែលបានចូលមើលក្នុងផ្លូវ។ >>> python_function([[1, 2, 3], [6, 5, 4], [7, 3, 9]]) 5.2"
"សូមសរសេរអនុគមន៍មួយដើម្បីភ្ជាប់បញ្ជីនៃចំនួនគត់ច្រើនទៅជាចំនួនគត់តែមួយ។ >>> python_function([11, 33, 50])==113350 True"
"សូមសរសេរអនុគមន៍មួយដើម្បីរកផលបូក និងមធ្យមភាគនៃចំនួនធម្មជាតិ n ដំបូង។ >>> python_function(10)==(55, 5.5) True"
"សូមសរសេរអនុគមន៍មួយដែលទទួលយកអារេ និងធាតុមួយ ហើយប្រគល់ tuple ដែលមានប៊ូលីនដែលបង្ហាញថាតើធាតុនោះស្ថិតនៅក្នុងអារេ និងទីតាំងលិបិក្រមរបស់ធាតុនោះ (ឬ -1 ប្រសិនបើធាតុនោះមិនត្រូវបានរកឃើញ)។ >>> python_function([11,23,58,31,56,77,43,12,65,19],31) (True, 3)"
"សូមសរសេរអនុគមន៍មួយដើម្បីពិនិត្យមើលថាតើចំនួនដែលបានផ្តល់ឱ្យជាចំនួន Armstrong ឬអត់។ >>> python_function(153)==True True"

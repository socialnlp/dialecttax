"ដោយ​ផ្តល់​ឲ្យ​ប្រវែង​នៃ​ជ្រុង​ទាំង​បី​នៃ​ត្រីកោណ។ ត្រឡប់ True ប្រសិនបើ​ជ្រុង​ទាំង​បី​បង្កើត​បាន​ជា​ត្រីកោណ​មុំ​ស្តាំ បើ​មិន​ដូច្នោះ​ទេ ត្រឡប់ False។ ត្រីកោណ​មុំ​ស្តាំ​គឺជា​ត្រីកោណ​ដែល​មុំ​មួយ​ជា​មុំ​ស្តាំ ឬ 90 ដឺក្រេ។ ឧទាហរណ៍៖ python_function(3, 4, 5) == True python_function(1, 2, 3) == False"
"សរសេរអនុគមន៍មួយដែលទទួលយកបញ្ជីខ្សែអក្សរ។ បញ្ជីនេះមានពាក្យផ្សេងៗគ្នា។ ប្រគល់ពាក្យដែលមានចំនួនតួអក្សរតែមួយគត់អតិបរមា។ ប្រសិនបើខ្សែអក្សរច្រើនមានចំនួនតួអក្សរតែមួយគត់អតិបរមា សូមប្រគល់ពាក្យដែលមកមុនគេតាមលំដាប់វាក្យសព្ទ។ python_function([\"name\", \"of\", \"string\"]) == \"string\" python_function([\"name\", \"enam\", \"game\"]) == \"enam\" python_function([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\""
"អ្នកជាទន្សាយឃ្លាន ហើយអ្នកបានញ៉ាំការ៉ុតចំនួនជាក់លាក់រួចហើយ ប៉ុន្តែឥឡូវនេះអ្នកត្រូវញ៉ាំការ៉ុតបន្ថែមទៀតដើម្បីបំពេញអាហារប្រចាំថ្ងៃ។ អ្នកគួរតែត្រឡប់អារេនៃ [ ចំនួនសរុបនៃការ៉ុតដែលបានញ៉ាំបន្ទាប់ពីអាហាររបស់អ្នក ចំនួននៃការ៉ុតដែលនៅសល់បន្ទាប់ពីអាហាររបស់អ្នក ] ប្រសិនបើមិនមានការ៉ុតដែលនៅសល់គ្រប់គ្រាន់ទេ អ្នកនឹងញ៉ាំការ៉ុតដែលនៅសល់ទាំងអស់ ប៉ុន្តែនៅតែឃ្លាន។ ឧទាហរណ៍៖ * python_function(5, 6, 10) -> [11, 4] * python_function(4, 8, 9) -> [12, 1] * python_function(1, 10, 10) -> [11, 0] * python_function(2, 11, 5) -> [7, 0] អថេរ៖ @number : integer ចំនួនការ៉ុតដែលអ្នកបានញ៉ាំ។ @need : integer ចំនួនការ៉ុតដែលអ្នកត្រូវញ៉ាំ។ @remaining : ចំនួនគត់ ចំនួនការ៉ុតដែលនៅសល់ ដែលមាននៅក្នុងស្តុក កម្រិត៖ * 0 <= ចំនួន <= 1000 * 0 <= ត្រូវការ <= 1000 * 0 <= នៅសល់ <= 1000 សូមរីករាយ :)"
"ប្រតិបត្តិករបញ្ជីពីរ និង operand។ បញ្ជីទីមួយមានប្រតិបត្តិការពិជគណិតមូលដ្ឋាន ហើយបញ្ជីទីពីរគឺជាបញ្ជីនៃចំនួនគត់។ ប្រើបញ្ជីពីរដែលបានផ្តល់ឱ្យដើម្បីបង្កើតកន្សោមពិជគណិត ហើយត្រឡប់ការវាយតម្លៃនៃកន្សោមនេះ។ ប្រតិបត្តិការពិជគណិតមូលដ្ឋាន៖ បូក (+) ដក (-) គុណ (*) ចែកជាន់ (//) និទស្សន្ត (**) ឧទាហរណ៍៖ operator['+', '*', '-'] array = [2, 3, 4, 5] result = 2 + 3 * 4 - 5 => result = 9 ចំណាំ៖ ប្រវែងនៃប្រតិបត្តិករ list គឺស្មើនឹងប្រវែងនៃ operand list ដកមួយ។ operand គឺជាបញ្ជីនៃចំនួនគត់មិនអវិជ្ជមាន។ ប្រតិបត្តិករ list មានប្រតិបត្តិករយ៉ាងហោចណាស់មួយ ហើយ operand list មាន operand យ៉ាងហោចណាស់ពីរ។"
"អ្នកនឹងទទួលបានខ្សែអក្សរ s។ ប្រសិនបើ s[i] ជាអក្សរ សូមបញ្ច្រាសអក្សរតូចទៅធំ ឬច្រាសមកវិញ បើមិនដូច្នោះទេ សូមរក្សាវាឱ្យនៅដដែល។ ប្រសិនបើខ្សែអក្សរមិនមានអក្សរទេ សូមបញ្ច្រាសខ្សែអក្សរ។ អនុគមន៍គួរតែប្រគល់ខ្សែអក្សរលទ្ធផល។ ឧទាហរណ៍ python_function(\"1234\") = \"4321\" python_function(\"ab\") = \"AB\" python_function(\"#a@C\") = \"#A@c\""
"ដោយ​ផ្តល់​ឲ្យ​ខ្សែអក្សរ 'text' សូម​ត្រឡប់​ខ្សែអក្សរ​សមមូល​នឹង md5 hash របស់វា។ ប្រសិនបើ 'text' ជា​ខ្សែអក្សរ​ទទេ សូម​ត្រឡប់ None។ >>> python_function('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'"
"ដោយ​ផ្តល់​ចំនួន​គត់​វិជ្ជមាន​ពីរ a និង b សូម​ត្រឡប់​ចំនួន​គត់​គូ​រវាង a និង b តាម​លំដាប់​ឡើង។ ឧទាហរណ៍៖ python_function(2, 8) => [2, 4, 6, 8] python_function(8, 2) => [2, 4, 6, 8] python_function(10, 14) => []"
"សរសេរអនុគមន៍មួយដើម្បីទាញយកតម្លៃរវាងសញ្ញាសម្រង់ \" \" នៃខ្សែអក្សរដែលបានផ្តល់ឱ្យ។ >>> python_function('Cortex \"A53\" Based \"multi\" tasking \"Processor\"') ['A53', 'multi', 'Processor']"
"សូមសរសេរអនុគមន៍មួយដើម្បីស្វែងរកធាតុដែលមានប្រេកង់អតិបរមានៅក្នុងបញ្ជីដែលបានផ្តល់ឱ្យ។ >>> python_function([2,3,8,4,7,9,8,2,6,5,1,6,1,2,3,2,4,6,9,1,2])==2 True"
"សរសេរអនុគមន៍មួយដើម្បីបង្ហាញពាក្យពីរពីបញ្ជីពាក្យដែលចាប់ផ្តើមដោយអក្សរ 'p'។ >>> python_function([\"Python PHP\", \"Java JavaScript\", \"c c++\"])==('Python', 'PHP') True"
"សរសេរអនុគមន៍មួយដើម្បីស្វែងរកភាពញឹកញាប់នៃធាតុនីមួយៗនៅក្នុងបញ្ជីដែលបានរាបស្មើ ដែលបានប្រគល់មកវិញនៅក្នុងវចនានុក្រម។ >>> python_function([[1, 2, 3, 2], [4, 5, 6, 2], [7, 8, 9, 5]])=={1: 1, 2: 3, 3: 1, 4: 1, 5: 2, 6: 1, 7: 1, 8: 1, 9: 1} ពិត"
"សរសេរអនុគមន៍មួយដើម្បីរកចំនួន n នៅក្នុងលំដាប់ newman conway។ >>> python_function(10) 6"
"សូមសរសេរអនុគមន៍ python ដើម្បីរកផលបូកនៃធាតុដែលមិនត្រូវបានធ្វើម្តងទៀតនៅក្នុងបញ្ជីដែលបានផ្តល់ឱ្យ។ >>> python_function([1,2,3,1,1,4,5,6]) 21"
"សូមសរសេរអនុគមន៍មួយដើម្បីរកផលបូកអតិបរមាដែលអាចធ្វើទៅបានដោយប្រើសមីការដែលបានផ្តល់ឱ្យ f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n). >>> python_function(60) 106"
"សូមសរសេរអនុគមន៍ python ដើម្បីបំបែក string ជាតួអក្សរ។ >>> python_function('python') ['p','y','t','h','o','n']"
"សរសេរអនុគមន៍មួយដើម្បីរកមេឌីយ៉ាននៃបញ្ជីពីរដែលបានតម្រៀបដែលមានទំហំដូចគ្នា។ >>> python_function([1, 12, 15, 26, 38], [2, 13, 17, 30, 45], 5) 16.0"
"សរសេរអនុគមន៍មួយដើម្បីគុណនឹងចំនួនទាំងអស់នៅក្នុងបញ្ជី ហើយចែកនឹងប្រវែងនៃបញ្ជី។ >>> python_function(python_function((8, 2, 3, -1, 7)), -67.2, rel_tol=0.001) True"
"សូមសរសេរអនុគមន៍ python ដើម្បីពិនិត្យមើលថាតើតម្លៃណាមួយនៅក្នុងលំដាប់មាននៅក្នុងលំដាប់ឬអត់។ >>> python_function([1,2,3,4,5],[6,7,8,9]) False"
"សរសេរអនុគមន៍ python ដើម្បីរកផលគុណនៃអារេ modulo n។ >>> python_function([ 100, 10, 5, 25, 35, 14 ],11) ==9 True"
"សូមសរសេរអនុគមន៍ python ដើម្បីរកចំនួនអប្បបរមាពីរ។ >>> python_function(1,2) 1"
"សូមសរសេរអនុគមន៍មួយដើម្បីរកផ្ទៃចំហៀងនៃកោណដែលបានផ្តល់ឱ្យកាំ r និងកម្ពស់ h។ >>> python_function(5,12)==204.20352248333654 True"
"សរសេរអនុគមន៍មួយដើម្បីតម្រៀបបញ្ជីខ្សែអក្សរនៃលេខដែលបានផ្តល់ឱ្យតាមលំដាប់លេខ។ >>> python_function(['4','12','45','7','0','100','200','-12','-500'])==[-500, -12, 0, 4, 7, 12, 45, 100, 200] ពិត"
"សរសេរអនុគមន៍មួយដើម្បីរកផ្ទៃចំហៀងនៃស៊ីឡាំងមួយ។ >>> python_function(python_function(10,5), 314.15000000000003, rel_tol=0.001) True"
"សរសេរអនុគមន៍មួយដែលយក tuples ពីរដែលមានប្រវែងដូចគ្នា ហើយអនុវត្តម៉ូឌុលក្នុងធាតុ។ >>> python_function((10, 4, 5, 6), (5, 6, 7, 5)) (0, 4, 5, 1)"
"សរសេរអនុគមន៍មួយដើម្បីលុបចន្លោះទទេទាំងអស់ចេញពីខ្សែអក្សរ។ >>> python_function('python program')==('pythonprogram') True"
"សរសេរអនុគមន៍មួយដើម្បីតម្រៀបវចនានុក្រមតាមតម្លៃ។ >>> python_function({'Math':81, 'Physics':83, 'Chemistry':87})==[('Chemistry', 87), ('Physics', 83), ('Math', 81)] ពិត"
"សរសេរអនុគមន៍មួយដើម្បីស្វែងរកធាតុទី k ពីអារេដែលបានតម្រៀបពីរដែលបានផ្តល់ឱ្យ។ >>> python_function([2, 3, 6, 7, 9], [1, 4, 8, 10], 5) 6"
"សរសេរអនុគមន៍មួយដើម្បីពិនិត្យមើលថាតើធាតុនីមួយៗនៃ tuple ទីពីរមានទំហំតូចជាងធាតុដែលត្រូវគ្នារបស់វានៅក្នុង tuple ទីមួយឬអត់។ >>> python_function((1, 2, 3), (2, 3, 4)) False"
"សូមសរសេរអនុគមន៍មួយដើម្បីបម្លែងខ្សែអក្សរដែលបានផ្តល់ឱ្យទៅជា tuple នៃតួអក្សរ។ >>> python_function(\"python 3.0\")==('p', 'y', 't', 'h', 'o', 'n', '3', '.', '0') True"
"សូមសរសេរអនុគមន៍ python ដើម្បីផ្លាស់ទីសូន្យទាំងអស់ទៅចុងបញ្ចប់នៃបញ្ជីដែលបានផ្តល់ឱ្យ។ >>> python_function([1,0,2,0,3,4]) [1,2,3,4,0,0]"
"សូមសរសេរអនុគមន៍មួយដើម្បីរកចំនួនបឋមទី n នៃ newman-shanks-williams។ >>> python_function(3) 7"
"សរសេរអនុគមន៍ python មួយយកចំនួនគត់ n ហើយត្រឡប់ផលបូកនៃការ៉េនៃចំនួនគត់ធម្មជាតិគូ n ដំបូង។ >>> python_function(2) 20"
"សរសេរអនុគមន៍មួយដើម្បីរកផលបូកនៃចំនួននៅក្នុងបញ្ជីក្នុងជួរដែលបានបញ្ជាក់ដោយសន្ទស្សន៍ពីរ។ >>> python_function([2,1,5,6,8,3,4,9,10,11,8,12], 8, 10) 29"

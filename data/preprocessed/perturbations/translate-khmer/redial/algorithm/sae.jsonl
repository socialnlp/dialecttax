"អ្នកនឹងទទួលបានទិន្នន័យ 2 វិមាត្រ ជាបញ្ជីដែលដាក់ក្នុងគ្នា ដែលស្រដៀងនឹងម៉ាទ្រីស ទោះជាយ៉ាងណាក៏ដោយ មិនដូចម៉ាទ្រីសទេ ជួរនីមួយៗអាចមានចំនួនជួរឈរខុសៗគ្នា។ ដោយផ្តល់ lst និងចំនួនគត់ x សូមរកចំនួនគត់ x នៅក្នុងបញ្ជី ហើយត្រឡប់បញ្ជីនៃ tuples [(x1, y1), (x2, y2) ...] ដើម្បីឱ្យ tuple នីមួយៗជាកូអរដោនេ - (ជួរដេក, ជួរឈរ) ដោយចាប់ផ្តើមដោយ 0។ តម្រៀបកូអរដោនេដំបូងតាមជួរដេកតាមលំដាប់ឡើង។ ដូចគ្នានេះដែរ តម្រៀបកូអរដោនេនៃជួរដេកតាមលំដាប់ចុះ។ ឧទាហរណ៍៖ python_function([ [1,2,3,4,5,6], [1,2,3,4,1,6], [1,2,3,4,5,1] ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)] python_function([], 1) == [] python_function([[], [1], [1, 2, 3]], 3) == [(2, 2)]"
"ដោយ​ផ្តល់​ឱ្យ​អារេ​នៃ​ចំនួន​គត់​មិន​អវិជ្ជមាន សូម​ត្រឡប់​ច្បាប់​ចម្លង​នៃ​អារេ​ដែល​បាន​ផ្តល់​ឱ្យ​បន្ទាប់​ពី​តម្រៀប អ្នក​នឹង​តម្រៀប​អារេ​ដែល​បាន​ផ្តល់​ឱ្យ​តាម​លំដាប់​ឡើង ប្រសិនបើ​ផលបូក (តម្លៃ​លិបិក្រម​ដំបូង តម្លៃ​លិបិក្រម​ចុងក្រោយ) ជា​ចំនួន​សេស ឬ​តម្រៀប​វា​តាម​លំដាប់​ចុះ ប្រសិនបើ​ផលបូក (តម្លៃ​លិបិក្រម​ដំបូង តម្លៃ​លិបិក្រម​ចុងក្រោយ) ជា​ចំនួន​គូ។ ចំណាំ៖ * កុំ​ផ្លាស់ប្ដូរ​អារេ​ដែល​បាន​ផ្តល់​ឱ្យ។ ឧទាហរណ៍៖ * python_function([]) => [] * python_function([5]) => [5] * python_function([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5] * python_function([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]"
